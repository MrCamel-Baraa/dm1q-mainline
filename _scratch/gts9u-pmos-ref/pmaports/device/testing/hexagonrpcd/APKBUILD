# Contributor: Galaxy Tab S9 Ultra port contributors <noreply@localhost>
# Maintainer: Dylan Van Assche <dylan@postmarketos.org>
pkgname=hexagonrpcd
pkgver=0.4.0
pkgrel=4
pkgdesc="Qualcomm HexagonFS daemon with Samsung sensor registry mapping"
url="https://github.com/linux-msm/hexagonrpc"
arch="aarch64"
license="GPL-3.0-or-later"
makedepends="linux-headers meson"
# Alpine edge's cross GCC currently cannot spawn cc1 in this workspace.
# Native AArch64 compilation through QEMU is slower but reproducible.
options="!pmb:crossdirect"
install="$pkgname.pre-install"
subpackages="$pkgname-doc $pkgname-systemd $pkgname-udev"

source="$pkgname-$pkgver.tar.gz::https://github.com/linux-msm/hexagonrpc/archive/refs/tags/v$pkgver.tar.gz
	10-fastrpc.rules
	https://gitlab.alpinelinux.org/alpine/aports/-/raw/master/community/hexagonrpcd/systemd-services.patch
	support-samsung-sensor-registry-writes.patch
	"
builddir="$srcdir/hexagonrpc-$pkgver"

build() {
	abuild-meson -Db_lto=true . output
	meson compile -C output
}

check() {
	meson test -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	install -Dm644 "$srcdir"/10-fastrpc.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/
}

