# Reference: <https://postmarketos.org/devicepkg>
maintainer="SM-X910 postmarketOS port <gts9uwifi@example.com>"
pkgname=device-samsung-gts9uwifi
pkgdesc="Samsung Galaxy Tab S9 Ultra Wi-Fi"
pkgver=1
pkgrel=44
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	android-tools
	bluez-btmgmt
	e2fsprogs-extra
	findmnt
	firmware-samsung-gts9uwifi
	gnome-control-center=999950.3-r2
	hexagonrpcd=0.4.0-r4
	hexagonrpcd-systemd=0.4.0-r4
	hexagonrpcd-udev=0.4.0-r4
	iio-sensor-proxy=3.9-r3
	iio-sensor-proxy-systemd=3.9-r3
	iio-sensor-proxy-udev=3.9-r3
	kbd
	linux-samsung-gts9uwifi-mainline
	linux-firmware-rtl_nic
	lsblk
	mkbootimg
	mutter=999950.2-r6
	partx
	pd-mapper
	postmarketos-base
	sfdisk
"
makedepends="devicepkg-dev"
source="
	99_gts9uwifi-sensors.gschema.override
	fastfetch-config.jsonc
	20-gts9uwifi-fbdev.conf
	20-gts9uwifi-address.conf
	20-gts9uwifi-display.conf
	20-gts9uwifi-panel-reinit.conf
	61-gts9uwifi-sensor-mount-matrix.rules
	99-gts9uwifi-logitech-lightspeed.rules
	deviceinfo
	gts9uwifi-display-handoff
	gts9uwifi-display-handoff.service
	gts9uwifi-display-hold.conf
	gts9uwifi-display-wake
	gts9uwifi-display-wake.service
	gts9uwifi-display-wake-system-sleep
	gts9uwifi-bluetooth-address
	gts9uwifi-bluetooth-address.service
	gts9uwifi-compile-sensor-schemas.service
	gts9uwifi-gdm-greeter-users
	gts9uwifi-gdm-greeter-users.service
	gts9uwifi-grow-rootfs
	gts9uwifi-grow-rootfs.service
	gts9uwifi-lightdm-hidpi
	gts9uwifi-panel-reinit
	gts9uwifi-panel-coldboot-recover
	gts9uwifi-panel-coldboot-recover.service
	gts9uwifi-sensors-resume
	gts9uwifi-sensors-resume-system-sleep
	gts9uwifi-usb-host-resume
	gts9uwifi-usb-host-resume-system-sleep
	gts9uwifi-wait-sensor-proxy
	gts9uwifi-wait-sensor-proxy.service
	gts9uwifi-xfce-hidpi
	gts9uwifi-xfce-hidpi.desktop
	kernel-cmdline.conf
	10-gts9uwifi-hexagonfs.conf
	10-gts9uwifi-lid.conf
	slick-greeter.conf
"

build() {
	devicepkg_build "$startdir" "$pkgname"
}

package() {
	devicepkg_package "$startdir" "$pkgname"

	install -Dm644 "$srcdir/99_gts9uwifi-sensors.gschema.override" \
		"$pkgdir/usr/share/glib-2.0/schemas/99_gts9uwifi-sensors.gschema.override"
	install -Dm644 "$srcdir/fastfetch-config.jsonc" \
		"$pkgdir/etc/xdg/fastfetch/config.jsonc"
	install -Dm644 "$srcdir/20-gts9uwifi-fbdev.conf" \
		"$pkgdir/usr/share/X11/xorg.conf.d/20-gts9uwifi-fbdev.conf"
	install -Dm755 "$srcdir/gts9uwifi-display-handoff" \
		"$pkgdir/usr/libexec/gts9uwifi-display-handoff"
	install -Dm644 "$srcdir/gts9uwifi-display-handoff.service" \
		"$pkgdir/usr/lib/systemd/system/gts9uwifi-display-handoff.service"
	install -d "$pkgdir/usr/lib/systemd/system/graphical.target.wants"
	ln -s ../gts9uwifi-display-handoff.service \
		"$pkgdir/usr/lib/systemd/system/graphical.target.wants/gts9uwifi-display-handoff.service"
	install -Dm644 "$srcdir/gts9uwifi-display-hold.conf" \
		"$pkgdir/usr/lib/modprobe.d/gts9uwifi-display-hold.conf"
	install -Dm755 "$srcdir/gts9uwifi-display-wake" \
		"$pkgdir/usr/libexec/gts9uwifi-display-wake"
	install -Dm644 "$srcdir/gts9uwifi-display-wake.service" \
		"$pkgdir/usr/lib/systemd/system/gts9uwifi-display-wake.service"
	install -Dm755 "$srcdir/gts9uwifi-display-wake-system-sleep" \
		"$pkgdir/usr/lib/systemd/system-sleep/gts9uwifi-display-wake"
	install -Dm755 "$srcdir/gts9uwifi-bluetooth-address" \
		"$pkgdir/usr/libexec/gts9uwifi-bluetooth-address"
	install -Dm644 "$srcdir/gts9uwifi-bluetooth-address.service" \
		"$pkgdir/usr/lib/systemd/system/gts9uwifi-bluetooth-address.service"
	install -Dm644 "$srcdir/20-gts9uwifi-address.conf" \
		"$pkgdir/etc/systemd/system/bluetooth.service.d/20-gts9uwifi-address.conf"
	install -Dm644 "$srcdir/gts9uwifi-compile-sensor-schemas.service" \
		"$pkgdir/usr/lib/systemd/system/gts9uwifi-compile-sensor-schemas.service"
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../gts9uwifi-compile-sensor-schemas.service \
		"$pkgdir/usr/lib/systemd/system/multi-user.target.wants/gts9uwifi-compile-sensor-schemas.service"
	# GDM >= 47 runs its greeter as "gdm-greeter-<N>" and asks systemd-userdbd
	# to create that account on demand.  Alpine builds systemd without userdbd,
	# so GDM crash-loops on a black screen; pre-allocate the accounts instead.
	install -Dm755 "$srcdir/gts9uwifi-gdm-greeter-users" \
		"$pkgdir/usr/libexec/gts9uwifi-gdm-greeter-users"
	install -Dm644 "$srcdir/gts9uwifi-gdm-greeter-users.service" \
		"$pkgdir/usr/lib/systemd/system/gts9uwifi-gdm-greeter-users.service"
	ln -s ../gts9uwifi-gdm-greeter-users.service \
		"$pkgdir/usr/lib/systemd/system/multi-user.target.wants/gts9uwifi-gdm-greeter-users.service"

	# The rootfs image is built without knowing the size of the target card,
	# so it grows itself once, on the device, at first boot.
	install -Dm755 "$srcdir/gts9uwifi-grow-rootfs" \
		"$pkgdir/usr/libexec/gts9uwifi-grow-rootfs"
	install -Dm644 "$srcdir/gts9uwifi-grow-rootfs.service" \
		"$pkgdir/usr/lib/systemd/system/gts9uwifi-grow-rootfs.service"
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../gts9uwifi-grow-rootfs.service \
		"$pkgdir/usr/lib/systemd/system/multi-user.target.wants/gts9uwifi-grow-rootfs.service"

	install -Dm755 "$srcdir/gts9uwifi-lightdm-hidpi" \
		"$pkgdir/usr/libexec/gts9uwifi-lightdm-hidpi"
	install -Dm755 "$srcdir/gts9uwifi-panel-reinit" \
		"$pkgdir/usr/libexec/gts9uwifi-panel-reinit"
	install -Dm755 "$srcdir/gts9uwifi-panel-coldboot-recover" \
		"$pkgdir/usr/libexec/gts9uwifi-panel-coldboot-recover"
	install -Dm644 "$srcdir/gts9uwifi-panel-coldboot-recover.service" \
		"$pkgdir/usr/lib/systemd/system/gts9uwifi-panel-coldboot-recover.service"
	install -d "$pkgdir/usr/lib/systemd/system/graphical.target.wants"
	ln -s ../gts9uwifi-panel-coldboot-recover.service \
		"$pkgdir/usr/lib/systemd/system/graphical.target.wants/gts9uwifi-panel-coldboot-recover.service"
	install -Dm644 "$srcdir/20-gts9uwifi-panel-reinit.conf" \
		"$pkgdir/etc/systemd/system/lightdm.service.d/20-gts9uwifi-panel-reinit.conf"
	install -Dm644 "$srcdir/20-gts9uwifi-display.conf" \
		"$pkgdir/etc/lightdm/lightdm.conf.d/20-gts9uwifi-display.conf"
	install -Dm755 "$srcdir/gts9uwifi-xfce-hidpi" \
		"$pkgdir/usr/libexec/gts9uwifi-xfce-hidpi"
	install -Dm644 "$srcdir/gts9uwifi-xfce-hidpi.desktop" \
		"$pkgdir/etc/xdg/autostart/gts9uwifi-xfce-hidpi.desktop"
	install -Dm644 "$srcdir/slick-greeter.conf" \
		"$pkgdir/etc/lightdm/slick-greeter.conf"

	install -Dm644 "$srcdir/10-gts9uwifi-hexagonfs.conf" \
		"$pkgdir/etc/systemd/system/hexagonrpcd-adsp-sensorspd.service.d/10-gts9uwifi-hexagonfs.conf"
	install -Dm644 "$srcdir/10-gts9uwifi-lid.conf" \
		"$pkgdir/etc/systemd/logind.conf.d/10-gts9uwifi-lid.conf"
	install -Dm644 "$srcdir/61-gts9uwifi-sensor-mount-matrix.rules" \
		"$pkgdir/usr/lib/udev/rules.d/61-gts9uwifi-sensor-mount-matrix.rules"
	install -Dm644 "$srcdir/99-gts9uwifi-logitech-lightspeed.rules" \
		"$pkgdir/usr/lib/udev/rules.d/99-gts9uwifi-logitech-lightspeed.rules"
	ln -s ../hexagonrpcd-adsp-sensorspd.service \
		"$pkgdir/usr/lib/systemd/system/multi-user.target.wants/hexagonrpcd-adsp-sensorspd.service"
	install -Dm755 "$srcdir/gts9uwifi-sensors-resume" \
		"$pkgdir/usr/libexec/gts9uwifi-sensors-resume"
	install -Dm755 "$srcdir/gts9uwifi-sensors-resume-system-sleep" \
		"$pkgdir/usr/lib/systemd/system-sleep/gts9uwifi-sensors-resume"
	install -Dm755 "$srcdir/gts9uwifi-usb-host-resume" \
		"$pkgdir/usr/libexec/gts9uwifi-usb-host-resume"
	install -Dm755 "$srcdir/gts9uwifi-usb-host-resume-system-sleep" \
		"$pkgdir/usr/lib/systemd/system-sleep/gts9uwifi-usb-host-resume"

	# The sensor PD publishes QRTR immediately but needs about a minute to
	# finish registry/hardware discovery. Starting iio-sensor-proxy earlier
	# makes it exit with "No sensors", and GNOME never retries it.
	install -Dm755 "$srcdir/gts9uwifi-wait-sensor-proxy" \
		"$pkgdir/usr/libexec/gts9uwifi-wait-sensor-proxy"
	install -Dm644 "$srcdir/gts9uwifi-wait-sensor-proxy.service" \
		"$pkgdir/usr/lib/systemd/system/gts9uwifi-wait-sensor-proxy.service"
	ln -s ../gts9uwifi-wait-sensor-proxy.service \
		"$pkgdir/usr/lib/systemd/system/multi-user.target.wants/gts9uwifi-wait-sensor-proxy.service"
}

