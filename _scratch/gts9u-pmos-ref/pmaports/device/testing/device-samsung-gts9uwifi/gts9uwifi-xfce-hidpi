#!/bin/sh
set -eu

# Keep the native 2960x1848 framebuffer.  XRandR transforms clip the reverse
# PRIME scanout, so scale GTK's complete widget coordinate space instead.
set_xfconf() {
	channel=$1
	property=$2
	type=$3
	value=$4

	if ! xfconf-query -c "$channel" -p "$property" -s "$value" 2>/dev/null; then
		xfconf-query -c "$channel" -p "$property" -n -t "$type" -s "$value"
	fi
}

set_xfconf xsettings /Xft/DPI int 96
set_xfconf xsettings /Gdk/WindowScalingFactor int 2
set_xfconf xsettings /Gtk/CursorThemeSize int 32
set_xfconf xfce4-panel /panels/panel-1/size uint 36
set_xfconf xfwm4 /general/theme string Default

# Cap the panel's volume slider at 100 %.  PulseAudio happily amplifies past
# 0 dB and the plugin exposes that by default, which on these speakers just
# clips - there is no Cirrus speaker-protection firmware loaded to catch it.
set_xfconf xfce4-panel /plugins/plugin-7/volume-max int 100

# The power key reaches userspace (PMIC PON pwrkey) and xfce4-power-manager
# takes a logind block-inhibitor on it, but with no action configured it
# silently swallows the press.  1 = suspend, which is what a tablet power
# button should do.  (4 turned out to be a straight shutdown on 4.20, not the
# "ask" dialog.)  Note the ANA38407 has no verified resume-from-blank path yet,
# so if the panel ever fails to come back this is the setting to revisit.
set_xfconf xfce4-power-manager /xfce4-power-manager/power-button-action uint 1
set_xfconf xfce4-power-manager /xfce4-power-manager/sleep-button-action uint 1
set_xfconf xfce4-power-manager /xfce4-power-manager/hibernate-button-action uint 0
set_xfconf xfce4-desktop /desktop-icons/icon-size uint 48

# Onboard applies GDK's 2x scale as well; use logical heights that result in a
# roughly 460 px landscape dock instead of doubling the previous 420 px dock.
gsettings set org.onboard.window.landscape dock-height 230
gsettings set org.onboard.window.landscape dock-expand true
gsettings set org.onboard.window.portrait dock-height 300

# The ANA38407 does not resume from a DPMS blank: once xfce4-power-manager's
# 17-minute "dpms-on-ac-off" fires the OLED goes warm-black and neither DPMS-on
# nor the xrandr off/on cycle relights it, only a full LightDM restart.  Until a
# real panel suspend/resume exists, keep the display always on: stop
# xfce4-power-manager from touching DPMS (the greeter already sets the Xorg
# timers to 0) and clear the X screensaver/DPMS timers immediately.
set_xfconf xfce4-power-manager /xfce4-power-manager/dpms-enabled bool false
set_xfconf xfce4-power-manager /xfce4-power-manager/dpms-on-ac-off uint 0
set_xfconf xfce4-power-manager /xfce4-power-manager/dpms-on-ac-sleep uint 0
set_xfconf xfce4-power-manager /xfce4-power-manager/dpms-on-battery-off uint 0
set_xfconf xfce4-power-manager /xfce4-power-manager/dpms-on-battery-sleep uint 0
set_xfconf xfce4-power-manager /xfce4-power-manager/blank-on-ac uint 0
set_xfconf xfce4-power-manager /xfce4-power-manager/blank-on-battery uint 0
xset s off -dpms || true

exit 0
