#!/bin/sh
# SPDX-License-Identifier: MIT
#
# system-sleep hooks run while user.slice is frozen.  A real system service is
# used instead of an anonymous timer: a new suspend can then cancel a wake left
# over from the preceding cycle.  This matters when the cover is opened and
# closed again within a few seconds.

case "$1" in
	pre)
		systemctl stop gts9uwifi-display-wake.service 2>/dev/null || true
		;;
	post)
		systemctl restart --no-block gts9uwifi-display-wake.service ||
			true
		;;
esac
