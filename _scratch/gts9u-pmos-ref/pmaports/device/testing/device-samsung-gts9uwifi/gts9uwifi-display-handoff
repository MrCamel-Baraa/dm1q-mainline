#!/bin/sh
set -eu

# LightDM starts X with -novtswitch.  On simpledrm the kernel can report VT7
# active while the physical scanout still contains VT1's last framebuffer.
# Bounce away and back after X has created its socket to force LeaveVT/EnterVT
# and an atomic redraw.  Keep the observations in the persistent journal.
attempt=0
while [ ! -S /tmp/.X11-unix/X0 ] && [ "$attempt" -lt 15 ]; do
	attempt=$((attempt + 1))
	sleep 1
done

before=$(fgconsole 2>&1 || true)
echo "SM-X910 display handoff: X socket=$([ -S /tmp/.X11-unix/X0 ] && echo ready || echo missing) active-before=$before"

chvt 1
sleep 1
chvt 7
sleep 1

after=$(fgconsole 2>&1 || true)
echo "SM-X910 display handoff: active-after=$after"

# Force a full KMS plane disable/enable after the VT transition.  simpledrm
# cannot change the physical mode, but this makes the modesetting DDX submit a
# complete plane update instead of relying on the stale boot-console scanout.
if command -v xrandr >/dev/null 2>&1; then
	DISPLAY=:0 XAUTHORITY=/var/run/lightdm/root/:0 \
		xrandr --output None-1 --off 2>&1 || true
	sleep 1
	DISPLAY=:0 XAUTHORITY=/var/run/lightdm/root/:0 \
		xrandr --output None-1 --mode 2960x1848 2>&1 || true
fi

# Persist the compatibility fbdev contents for offline comparison with the panel.
# 2960 * 1848 * 4 = 21880320 bytes = 42735 blocks of 512 bytes.
sleep 5
if [ -c /dev/fb0 ]; then
	frame=/var/log/gts9uwifi-fb0-after-x.raw
	if dd if=/dev/fb0 of="$frame" bs=512 count=42735 2>/dev/null; then
		sync "$frame" 2>/dev/null || sync
		echo "SM-X910 display handoff: framebuffer=$(sha256sum "$frame")"
	else
		echo "SM-X910 display handoff: framebuffer capture failed"
	fi
fi
