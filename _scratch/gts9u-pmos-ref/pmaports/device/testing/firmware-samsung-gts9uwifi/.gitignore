# Proprietary firmware blobs are regenerated by the scripts/stage-stock-*.sh
# helpers against pinned SHA-256/512 checksums; they are never versioned.
#
# The ADSP set below was committed by mistake in session 82 and purged from the
# history in session 93: this file did not list it, so the "never versioned"
# rule above silently did not apply to it.  scripts/stage-stock-adsp-firmware.sh
# now pulls it from the device's own apnhlos partition and verifies every file
# against adsp-firmware.sha512.
adsp.mdt
adsp.b*
adsp_dtb.mdt
adsp_dtb.b*
adspr.jsn
adsps.jsn
adspua.jsn
cdspr.jsn

amss20.bin
phy_ucode20.elf
bdwlan.elf
regdb.bin
bdwlan-payload.bin
m3.bin
official-amss.bin
official-board-2.bin
qrd-board.bin
samsung-board-2.bin
a740_zap.mdt
a740_zap.b00
a740_zap.b01
a740_zap.b02
a740_sqe.fw
gmu_gen70200.bin
hmtbtfw20.tlv
hmtnv20.bin
hmtnv20.b21
hmtnv20.b22
hmtnv20.b38
cs35l45-dsp1-spk-prot.wmfw
cs35l45-dsp1-spk-prot.bin
cs35l45-dsp1-spk-prot-calib.bin
Samsung-Galaxy-Tab-S9-Ultra-tplg.bin
