package() {
	local fw="$pkgdir/usr/lib/firmware/ath12k/WCN7850/hw2.0"
	# Official linux-firmware amss: Samsung's downstream amss stalls WLAN
	# start under mainline ath12k (it expects the cnss2-only phy_ucode QMI).
	install -Dm644 "$srcdir/official-amss.bin" "$fw/amss.bin"
	# Canonical linux-firmware M3; Samsung ships no m3 for kiwi.
	install -Dm644 "$srcdir/m3.bin" "$fw/m3.bin"
	# No official X910/board-id 255 entry yet; use the proven QRD ELF fallback.
	install -Dm644 "$srcdir/official-board-2.bin" "$fw/board-2.bin"
	install -Dm644 "$srcdir/qrd-board.bin" "$fw/board.bin"
	install -Dm644 "$srcdir/regdb.bin" "$fw/regdb.bin"

	# WCN7850 Bluetooth over QUP SE14.  The X910 DTS explicitly requests the
	# validated Samsung b21 NVM; retain the other stock variants and generic
	# image for diagnostics and fallback experiments.
	local bt="$pkgdir/usr/lib/firmware/qca"
	install -Dm644 "$srcdir/hmtbtfw20.tlv" "$bt/hmtbtfw20.tlv"
	install -Dm644 "$srcdir/hmtnv20.bin" "$bt/hmtnv20.bin"
	install -Dm644 "$srcdir/hmtnv20.b21" "$bt/hmtnv20.b21"
	install -Dm644 "$srcdir/hmtnv20.b22" "$bt/hmtnv20.b22"
	install -Dm644 "$srcdir/hmtnv20.b38" "$bt/hmtnv20.b38"

	# ADSP (audio DSP) boot image.  Samsung's own signed adsp.mdt + segments,
	# extracted from the apnhlos partition; the mainline qcom_q6v5_pas mdt loader
	# reads adsp.mdt and pulls each adsp.bNN segment.  Placed under sm8550/ to
	# match the DTS firmware-name = "qcom/sm8550/adsp.mdt".  Empty segments
	# (b26/b29/b37/b50) are absent by design — the loader skips filesz=0 PT_LOADs.
	local adsp="$pkgdir/usr/lib/firmware/qcom/sm8550"
	for seg in "$srcdir"/adsp.mdt "$srcdir"/adsp.b* \
		   "$srcdir"/adsp_dtb.mdt "$srcdir"/adsp_dtb.b*; do
		install -Dm644 "$seg" "$adsp/${seg##*/}"
	done

	# Four CS35L45 smart amplifiers. These are the exact X910 speaker
	# protection image, coefficients and calibration defaults from Samsung's
	# published source package. The mainline wm_adsp loader requests them at
	# the firmware root using these canonical names.
	for blob in \
		cs35l45-dsp1-spk-prot.wmfw \
		cs35l45-dsp1-spk-prot.bin \
		cs35l45-dsp1-spk-prot-calib.bin; do
		install -Dm644 "$srcdir/$blob" \
			"$pkgdir/usr/lib/firmware/$blob"
	done

	# AudioReach graph topology. The upstream SM8550-HDK topology already
	# contains the PRIMARY_MI2S_RX and VA_CODEC_DMA_TX_0/TX3 graphs used by
	# this board. q6apm derives the filename from the DTS card model.
	install -Dm644 "$srcdir/Samsung-Galaxy-Tab-S9-Ultra-tplg.bin" \
		"$pkgdir/usr/lib/firmware/qcom/sm8550/Samsung-Galaxy-Tab-S9-Ultra-tplg.bin"

	# Protection-domain maps for pd-mapper.  Nothing in the kernel answers the
	# servreg locator QMI service, so the q6apm/q6prm nodes that carry
	# qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd" wait forever and
	# no APR/GPR device is ever created.  pd-mapper provides that service, and it
	# looks for *.jsn strictly in the directory of each remoteproc's firmware
	# (it reads /sys/class/remoteproc/*/firmware and takes its dirname), so these
	# must sit next to adsp.mdt.  adspua.jsn is the one that maps avs/audio onto
	# msm/adsp/audio_pd; the others come from the same Samsung apnhlos image.
	for map in adspr.jsn adsps.jsn adspua.jsn cdspr.jsn; do
		install -Dm644 "$srcdir/$map" "$adsp/$map"
	done

	# HexagonFS tree consumed by hexagonrpcd when it attaches the Samsung
	# sensor protection domain.  It is generated deterministically from the
	# X910 stock vendor sensor JSONs; no writable persist data or per-device
	# calibration is embedded in the package.
	mkdir -p "$pkgdir/usr/share/qcom/sm8550/Samsung/gts9uwifi"
	cp -a "$srcdir/sensor-hexagonfs/." \
		"$pkgdir/usr/share/qcom/sm8550/Samsung/gts9uwifi/"
}

