maintainer="SM-X910 postmarketOS port <gts9uwifi@example.com>"
pkgname=gnome-control-center
_pkgver=50.3
pkgver=9999$_pkgver
pkgrel=2
pkgdesc="GNOME control center with SM-X910 hardware names"
url="https://gitlab.gnome.org/GNOME/gnome-control-center"
arch="all"
license="GPL-2.0-or-later"
depends="
	accountsservice
	colord
	cups-pk-helper
	dbus:org.freedesktop.Secrets
	openrc-settingsd
	setxkbmap
	"
makedepends="
	accountsservice-dev
	blueprint-compiler
	cairo-dev
	colord-dev
	colord-gtk-dev
	cups-dev
	docbook-xml
	docbook-xsl
	gcr4-dev
	glib-dev
	gmobile-dev
	gnome-bluetooth-dev
	gnome-desktop-dev
	gnome-online-accounts-dev
	gnome-settings-daemon-dev
	gsettings-desktop-schemas-dev
	gsound-dev
	ibus-dev
	itstool
	krb5-dev
	libadwaita-dev
	libgtop-dev
	libgudev-dev
	libnma-dev
	libpwquality-dev
	libsecret-dev
	libwacom-dev
	libxml2-utils
	libxslt
	malcontent-dev
	meson
	modemmanager-dev
	networkmanager-dev
	polkit-dev
	pulseaudio-dev
	samba-dev
	tecla-dev
	udisks2-dev
	upower-dev
	"
options="!check !pmb:crossdirect"
install="$pkgname.pre-install $pkgname.pre-upgrade"
subpackages="$pkgname-dbg $pkgname-dev $pkgname-lang $pkgname-doc $pkgname-bash-completion"
source="https://download.gnome.org/sources/gnome-control-center/${_pkgver%%.*}/gnome-control-center-$_pkgver.tar.xz
	README.alpine
	pretty-sm8550-a740-names.patch
	"
builddir="$srcdir/$pkgname-$_pkgver"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dibus=true \
		-Dlocation-services=enabled \
		-Dmalcontent=true \
		. output

	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	mkdir -p "$pkgdir"/usr/lib/pkgconfig
	mv "$pkgdir"/usr/share/pkgconfig/* "$pkgdir"/usr/lib/pkgconfig
	rmdir "$pkgdir"/usr/share/pkgconfig

	install -Dm0644 "$srcdir"/README.alpine -t "$pkgdir"/usr/share/doc/"$pkgname"
}

