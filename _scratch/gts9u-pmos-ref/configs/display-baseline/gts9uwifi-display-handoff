#!/bin/sh
set -eu

# LightDM/Xorg performs the handoff itself in the physically working baseline.
echo "SM-X910 display handoff: disabled for pre-v0.19 known-good baseline"

# Collect the PCIe/WCN clock and pinctrl state from userspace.  Reading the
# same state through temporary kernel MMIO instrumentation made v0.41 reboot
# before journald could persist a boot, so keep this deliberately read-only.
tag=gts9uwifi-wifi-diag
if ! mountpoint -q /sys/kernel/debug 2>/dev/null; then
	mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || true
fi

logger -t "$tag" "begin userspace PCIe/WCN snapshot"
if [ -r /sys/kernel/debug/clk/clk_summary ]; then
	grep -Ei 'pcie|wcn|wlan|sleep_clk' /sys/kernel/debug/clk/clk_summary \
		| while IFS= read -r line; do logger -t "$tag" -- "$line"; done \
		|| true
else
	logger -t "$tag" "clk_summary unavailable"
fi
if [ -r /sys/kernel/debug/gpio ]; then
	grep -E 'gpio-(80|81|82|83|94|95|96)[[:space:]]' /sys/kernel/debug/gpio \
		| while IFS= read -r line; do logger -t "$tag" -- "$line"; done \
		|| true
else
	logger -t "$tag" "GPIO debug unavailable"
fi
for file in /sys/kernel/debug/pinctrl/*/pinmux-pins; do
	[ -r "$file" ] || continue
	grep -E 'pin (80|81|82|83|94|95|96) ' "$file" \
		| while IFS= read -r line; do logger -t "$tag" -- "$line"; done \
		|| true
done
# Enumerated PCI devices: 17cb:0113 is only the root port; success means a
# second entry with vendor/device 17cb:1107 and ath12k bound to it.
list_pci() {
	for dev in /sys/bus/pci/devices/*; do
		[ -e "$dev" ] || continue
		driver=none
		[ -L "$dev/driver" ] && driver=$(basename "$(readlink "$dev/driver")")
		logger -t "$tag" -- "pci $1 $(basename "$dev") id=$(cat "$dev/vendor" 2>/dev/null):$(cat "$dev/device" 2>/dev/null) driver=$driver"
	done
}
list_pci initial
# The LTSSM keeps polling Detect after the probe-time "Device not found".
# If the endpoint became electrically ready later, the link trains silently;
# a rescan this late would then enumerate 17cb:1107 without a reboot.
if [ -w /sys/bus/pci/rescan ]; then
	echo 1 > /sys/bus/pci/rescan 2>/dev/null || true
	sleep 2
	list_pci after-rescan
fi
logger -t "$tag" "end userspace PCIe/WCN snapshot"
