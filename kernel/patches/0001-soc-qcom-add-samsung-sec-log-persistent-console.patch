index 000000000..e517f2bf4
--- /dev/null
+++ b/drivers/soc/qcom/samsung-sec-log.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Persistent early console for Samsung SM8550 devices (dm1q bring-up aid).
+ *
+ * Samsung's bootloader and downstream recovery share a 2 MiB ring in the
+ * "sec_log_buf" reserved-memory region.  Recovery's sec_log driver exposes
+ * the previous contents as /proc/last_kmsg, so a mainline kernel that dies
+ * (or gets reset by TrustZone) can still be diagnosed from recovery without
+ * a UART or a camera pointed at the screen.
+ *
+ * The header layout is the Samsung one ("LOGM" magic); the approach follows
+ * the gts9uwifi bring-up patch by agcarbajo (GPL-2.0), rewritten to register
+ * from an early_initcall so that messages from before the pinctrl/regulator
+ * probes are captured as well (CON_PRINTBUFFER replays everything already in
+ * the printk buffer).  Both indices are updated on every write: a warm reset
+ * or a TZ fatal does not run Samsung's index hand-over path.
+ */
+
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/string.h>
+
+#define SEC_LOG_MAGIC	0x4d474f4c /* "LOGM" little-endian */
+
+struct sec_log_header {
+	u32 boot_count;
+	u32 magic;
+	u32 index;
+	u32 previous_index;
+	u8 data[];
+};
+
+static struct sec_log_header *sec_log_hdr;
+static size_t sec_log_data_size;
+
+static void notrace sec_log_write(struct console *con, const char *text,
+				  unsigned int count)
+{
+	struct sec_log_header *hdr = sec_log_hdr;
+	size_t first;
+	u32 index;
+
+	if (!hdr || !count || !sec_log_data_size)
+		return;
+
+	if (count > sec_log_data_size) {
+		text += count - sec_log_data_size;
+		count = sec_log_data_size;
+	}
+
+	index = READ_ONCE(hdr->index);
+	first = min_t(size_t, count, sec_log_data_size - index % sec_log_data_size);
+	memcpy(&hdr->data[index % sec_log_data_size], text, first);
+	if (first != count)
+		memcpy(hdr->data, text + first, count - first);
+
+	/* index is monotonically increasing, as in the downstream ring */
+	WRITE_ONCE(hdr->index, index + count);
+	WRITE_ONCE(hdr->previous_index, index + count);
+}
+
+static struct console sec_log_console = {
+	.name	= "sec_log",
+	.write	= sec_log_write,
+	.flags	= CON_ENABLED | CON_ANYTIME | CON_PRINTBUFFER,
+	.index	= -1,
+};
+
+static int __init sec_log_init(void)
+{
+	struct device_node *np, *mem_np;
+	struct reserved_mem *rmem;
+	void *mem;
+
+	np = of_find_compatible_node(NULL, NULL, "samsung,sec-kernel-log");
+	if (!np)
+		return 0;
+
+	mem_np = of_parse_phandle(np, "memory-region", 0);
+	of_node_put(np);
+	if (!mem_np)
+		return 0;
+
+	rmem = of_reserved_mem_lookup(mem_np);
+	of_node_put(mem_np);
+	if (!rmem || rmem->size <= sizeof(struct sec_log_header)) {
+		pr_err("sec_log: invalid sec_log_buf reservation\n");
+		return 0;
+	}
+
+	mem = memremap(rmem->base, rmem->size, MEMREMAP_WB);
+	if (!mem) {
+		pr_err("sec_log: cannot map sec_log_buf\n");
+		return 0;
+	}
+
+	sec_log_hdr = mem;
+	sec_log_data_size = rmem->size - sizeof(*sec_log_hdr);
+
+	if (READ_ONCE(sec_log_hdr->magic) != SEC_LOG_MAGIC) {
+		WRITE_ONCE(sec_log_hdr->boot_count, 0);
+		WRITE_ONCE(sec_log_hdr->magic, SEC_LOG_MAGIC);
+		WRITE_ONCE(sec_log_hdr->index, 0);
+	}
+	WRITE_ONCE(sec_log_hdr->boot_count, sec_log_hdr->boot_count + 1);
+	WRITE_ONCE(sec_log_hdr->previous_index, sec_log_hdr->index);
+	WRITE_ONCE(sec_log_hdr->index, 0);
+
+	register_console(&sec_log_console);
+	pr_info("sec_log: persistent console at %pa (%zu bytes)\n",
+		&rmem->base, (size_t)rmem->size);
+	return 0;
+}
+early_initcall(sec_log_init);
