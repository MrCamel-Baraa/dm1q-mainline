+	{ }
+};
+MODULE_DEVICE_TABLE(spi, fts2ba61y_spi_ids);
+
+static struct spi_driver fts2ba61y_driver = {
+	.driver = {
+		.name = "fts2ba61y",
+		.of_match_table = fts2ba61y_of_match,
+	},
