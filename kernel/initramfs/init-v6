#!/bin/busybox sh
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null
/bin/busybox mkdir -p /dev/pts
/bin/busybox mount -t devpts devpts /dev/pts 2>/dev/null
/bin/busybox mount -t configfs configfs /sys/kernel/config 2>/dev/null
/bin/busybox mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null

echo ""
echo "======================================================"
echo " dm1q mainline v6 -- initramfs is running"
echo "======================================================"
/bin/busybox uname -a
echo "======================================================"
echo "[diag] /sys/class/block/*: $(/bin/busybox ls /sys/class/block/ 2>&1 | /bin/busybox head -c 200)"
echo "[diag] /proc/partitions:"
/bin/busybox cat /proc/partitions 2>&1
echo "======================================================"

# ---- Show the PREVIOUS boot's console, if ramoops has one ----
/bin/busybox mount -t pstore pstore /sys/fs/pstore 2>/dev/null
P=$(/bin/busybox ls /sys/fs/pstore/ 2>/dev/null | /bin/busybox grep console-ramoops | /bin/busybox head -1)
if [ -n "$P" ]; then
	echo "(previous boot's pstore console found: /sys/fs/pstore/$P --"
	echo " also being written to flash below, no need to read it here)"
else
	echo "(no previous-boot console in pstore)"
fi
echo "======================================================"

# ---- Continuously flush THIS boot's own kernel log to flash. ----
# Does not depend on ramoops surviving a reset, does not depend on USB, does
# not depend on a screen/photo. Uses the unused padding inside the flashed
# dtbo partition (16 MiB; our real content is only the first 4096 bytes plus
# a 512-byte AVB vbmeta blob right after -- see docs/01-phase1-workplan.md
# 2026-09-22. Writing at 1 MiB offset is nowhere near either).
# Retrieve with (from recovery or any Linux box with the device):
#   adb shell dd if=/dev/block/by-name/dtbo bs=1M skip=1 count=4 2>/dev/null \
#     | tr -d '\0' > klog.txt
(
  # No udev/mdev here, so /dev/block/by-name/* doesn't exist. The kernel's
  # own GPT parser (CONFIG_EFI_PARTITION) exposes PARTNAME= in sysfs
  # independent of any userspace helper -- use that instead of guessing a
  # device node number (recovery's numbering is a DIFFERENT kernel and is
  # not guaranteed to match ours). v6 silently dd'd to a hardcoded
  # /dev/block/by-name/dtbo that never existed -- see docs/01-phase1-workplan.md
  # 2026-09-22 (empty log, first v6 boot). This looks the device up for real.
  D=""
  echo "[flashlog] looking up dtbo device node..."
  while true; do
    if [ -z "$D" ]; then
      for u in /sys/class/block/*/uevent; do
        /bin/busybox grep -q '^PARTNAME=dtbo$' "$u" 2>/dev/null || continue
        NAME=$(/bin/busybox grep '^DEVNAME=' "$u" | /bin/busybox cut -d= -f2)
        [ -n "$NAME" ] && D="/dev/$NAME" && echo "[flashlog] dtbo device: $D" && break
      done
    fi
    /bin/busybox dmesg > /tmp/klog.txt 2>&1
    SZ=$(/bin/busybox wc -c < /tmp/klog.txt)
    if [ -n "$D" ] && [ "$SZ" -gt 0 ] && [ "$SZ" -lt 4194304 ]; then
      /bin/busybox dd if=/tmp/klog.txt of=$D bs=1M seek=1 conv=notrunc
    fi
    /bin/busybox sleep 3
  done
) &

echo "USB gadget (ACM serial shell) is being set up in the"
echo "background: expect /dev/ttyACM0 on the host."
echo "======================================================"

# ---- USB peripheral gadget: CDC-ACM serial, then a shell on ttyGS0 ----
(
  G=/sys/kernel/config/usb_gadget/dm1q
  /bin/busybox mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409 $G/functions/acm.usb0
  echo 0x1d6b > $G/idVendor
  echo 0x0104 > $G/idProduct
  echo "dm1q-mainline" > $G/strings/0x409/serialnumber
  echo "dm1q mainline" > $G/strings/0x409/manufacturer
  echo "dm1q initramfs console" > $G/strings/0x409/product
  echo "ACM" > $G/configs/c.1/strings/0x409/configuration
  /bin/busybox ln -s $G/functions/acm.usb0 $G/configs/c.1/ 2>/dev/null
  n=0
  U=""
  while [ $n -lt 300 ]; do
    for u in /sys/class/udc/*; do [ -e "$u" ] && U=${u##*/} && break; done
    [ -n "$U" ] && break
    n=$((n+1))
    if [ $((n % 10)) -eq 0 ]; then echo "[gadget] still waiting for a UDC (${n}s)..."; fi
    /bin/busybox sleep 1
  done
  if [ -n "$U" ]; then
    echo "$U" > $G/UDC
    echo "[gadget] bound to UDC $U"
  else
    echo "[gadget] no UDC appeared after 300 s (see dmesg | grep -i -E 'dwc3|eusb2|ptn3222')"
    exit 0
  fi
  while [ ! -c /dev/ttyGS0 ]; do /bin/busybox sleep 1; done
  while true; do
    /bin/busybox setsid /bin/busybox sh -c 'exec /bin/busybox sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'
    /bin/busybox sleep 1
  done
) &

exec /bin/busybox sh
