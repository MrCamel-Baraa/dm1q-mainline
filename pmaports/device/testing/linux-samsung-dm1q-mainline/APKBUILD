# real; also note deviceinfo_flash_method="none" means pmbootstrap's normal
# install/flash path is not exercised yet either -- see the deviceinfo file
# in ../device-samsung-dm1q/ and docs/06-pmos-userspace-plan.md for the
# real (manual, hand-assembled) boot image process this device currently
# needs instead.
sha512sums="
