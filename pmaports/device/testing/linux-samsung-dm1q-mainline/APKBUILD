# STATUS (2026-09-27): first draft, never built with abuild/pmbootstrap yet.
# Structural template: the gts9uwifi kernel package
# (../_scratch/gts9u-pmos-ref/pmaports/device/testing/linux-samsung-gts9uwifi-mainline/APKBUILD).
# Content (DTS, config fragment, sec-log patch) is dm1q's own real,
# hardware-verified v12 bring-up work -- see docs/06-pmos-userspace-plan.md
# and docs/01-phase1-workplan.md for what's actually been confirmed on
# real hardware vs. still open (no WLAN/display driver wired to a real
# rootfs yet, SPMI USID-7/PM8550B identify-read failure still open).
maintainer="dm1q mainline port <dm1q-mainline@example.com>"
_flavor="samsung-dm1q-mainline"
pkgname=linux-$_flavor
# Matches the kernel version actually built and confirmed booting on
# hardware in v10-v12 (see docs/01-phase1-workplan.md, 2026-09-20 onward).
# TODO: move to a released kernel (or a fresher -rc) before any real
# submission; -rc3 was simply what was checked out at the time.
pkgver=7.3_rc3
# r2 was a pure reproducibility test (DTS unchanged, forced recompile --
# see docs/07-wlan-bringup.md). r3 (2026-09-30): DTS changed for real again
# (wifi@0 re-added, PDC content reverted to the known-safe value).
# r4 (2026-10-01): ROOT CAUSE of the "pcie0 regression" fixed in the config
# fragment (kernel lockdown forced off: every rebuild used to get a fresh
# module-signing key that the rootfs' modules were not signed with, so no
# module loaded -- docs/07 "ROOT CAUSE FOUND 2026-10-01") plus the WLAN
# pwrctrl wiring reworked in the DTS (wifi@0 under &pcie0_port0, supplies =
# the PMU's own output regulators, compatible 1103, PMU regulators{} added,
# WLAN PDC table restored). The two changed sha512sums below were computed
# with plain sha512sum; `pmbootstrap checksum` should leave them unchanged.
# KBUILD_BUILD_VERSION is pkgrel+1, so r4 reports "#5-samsung-dm1q-mainline".
# r5 (2026-10-08): carries the upstream PCIe fix pci-qcom-honor-iommu-cells-in-config-sid.patch.
# 7.3-rc3 programs the PCIe controller's BDF-to-SID table from a mis-parsed 5-cell
# iommu-map, so the WLAN endpoint (01:00.0) gets no table entry and its MSIs never
# reach the host (docs/07 section 14). DTS and config fragment are unchanged from r4.
# r5 reports "#6-samsung-dm1q-mainline".
# r6 (2026-10-12): touchscreen. Adds add-fts2ba61y-touchscreen.patch (the
# STMicro FTS2BA61Y SPI driver, binding, Kconfig/Makefile; docs/08 section 2),
# CONFIG_TOUCHSCREEN_FTS2BA61Y=m in the fragment, and the DTS now carries the
# keys (v11) and the spi4 touchscreen node + L12B/L16B rails + gpi_dma1 (v12).
# r6 reports "#7-samsung-dm1q-mainline".
# r7 (2026-10-14): native display, first attempt (docs/09). Adds
# add-s6e3fac-amb606aw01-panel.patch (panel driver + binding + Kconfig/Makefile,
# kernel/patches/0003-*), DRM_MSM/SM_DISPCC_8550/the panel as modules in the
# fragment, and the DTS now carries mdss + dsi0 + dsi0_phy + the S6E3FAC panel
# with its three GPIO rails. Kernel code and config changed: the rootfs module
# tree must be refreshed (scripts/refresh-phone-modules.sh) before booting it.
# r7 reports "#8-samsung-dm1q-mainline".
# r9 (2026-10-23): touchscreen debugfs raw SPI knob for the drop-out investigation (docs/08 section 2.19). Adds
# add-fts2ba61y-raw-knob.patch (kernel/patches/0004-*), applied after add-fts2ba61y-touchscreen.patch. The driver
# code changed: after the build, flash boot + vendor_boot, then refresh the rootfs modules
# (scripts/refresh-phone-modules.sh). r9 reports "#10-samsung-dm1q-mainline".
# r10 (2026-10-23): the Adreno 740 is enabled in the DTS (&gpu okay + zap-shader firmware-name, docs/11 9.14). The DTS was the
# only change; no kernel code changed against r9, so the rootfs module tree of r9 stays valid. NOT BUILT: boot image sets take the
# DTS from dts/dm1q/dm1q.dts (scripts/make-dtb-image-set.sh); build r10 when the next kernel change needs a package. r10 would
# report "#11-samsung-dm1q-mainline".
pkgrel=10
pkgdesc="Mainline kernel for Samsung Galaxy S23 (dm1q)"
arch="aarch64"
_carch="arm64"
url="https://kernel.org"
license="GPL-2.0-only"
options="
	!check
	!strip
	!tracedeps
	pmb:cross-native
"
makedepends="
	bash
	bc
	bison
	clang
	diffutils
	elfutils-dev
	findutils
	flex
	kmod
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	sed
	zstd
"

_kernelver="${pkgver/_/-}"
# TODO: this is the same commit the gts9uwifi reference package uses (see
# docs/03-references.md's real-commit verification of that package) --
# reused here only as a known-real starting point for config-mainline.
# aarch64. Re-check against current gitlab.postmarketos.org HEAD before
# actually building; a stale config isn't a correctness risk (it's a
# baseline that gets merge_config'd against below), but pin to something
# current before submitting this package anywhere.
_pmaports_commit="b7681d0e857d395edfaa6c8e5cd0d89e4315fd3f"

source="
	linux-$_kernelver.tar.gz::https://git.kernel.org/torvalds/t/linux-$_kernelver.tar.gz
	config-mainline.aarch64::https://gitlab.postmarketos.org/postmarketOS/pmaports/-/raw/$_pmaports_commit/device/main/linux-postmarketos-mainline/config-mainline.aarch64
	add-samsung-sec-log-console.patch
	pci-qcom-honor-iommu-cells-in-config-sid.patch
	add-fts2ba61y-touchscreen.patch
	add-fts2ba61y-raw-knob.patch
	add-s6e3fac-amb606aw01-panel.patch
	config-dm1q.fragment
	sm8550-samsung-dm1q.dts
"
builddir="$srcdir/linux-$_kernelver"

prepare() {
	default_prepare

	cp "$srcdir/sm8550-samsung-dm1q.dts" arch/arm64/boot/dts/qcom/
	grep -q 'sm8550-samsung-dm1q.dtb' arch/arm64/boot/dts/qcom/Makefile || \
		echo 'dtb-$(CONFIG_ARCH_QCOM) += sm8550-samsung-dm1q.dtb' \
			>> arch/arm64/boot/dts/qcom/Makefile

	cp "$srcdir/config-mainline.aarch64" .config

	unset LDFLAGS
	scripts/kconfig/merge_config.sh -m \
		.config "$srcdir/config-dm1q.fragment"
	make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor"
}

package() {
	make modules_install zinstall dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	rm -f "$pkgdir"/usr/lib/modules/*/build
	rm -f "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/"$_flavor"/kernel.release
}

