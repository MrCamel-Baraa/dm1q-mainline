# Reference: <https://postmarketos.org/devicepkg>
#
# STATUS (2026-09-27): first draft, never built with pmbootstrap yet. No
# device-specific userspace hooks exist so far (no display/sensor/audio
# bring-up done -- see docs/06-pmos-userspace-plan.md) so this package is
# deliberately minimal: postmarketos-base plus the current kernel, nothing
# device-specific to install yet.
maintainer="dm1q mainline port <baraa.amr.elgamal@gmail.com>"
pkgname=device-samsung-dm1q
pkgdesc="Samsung Galaxy S23"
pkgver=1
pkgrel=2
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	e2fsprogs-extra
	findmnt
	kbd
	linux-samsung-dm1q-mainline
	lsblk
	partx
	postmarketos-base
	sfdisk
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	10-dm1q-console.conf
"

build() {
	devicepkg_build "$startdir" "$pkgname"
}

package() {
	devicepkg_package "$startdir" "$pkgname"

	# console loglevel after boot (docs/09 section 16.1): the cmdline stays at loglevel=7
	# for the early log, userspace lowers it so late kernel lines stop painting over the login prompt
	install -Dm644 "$srcdir"/10-dm1q-console.conf \
		"$pkgdir"/etc/sysctl.d/10-dm1q-console.conf
}

# PLACEHOLDER -- not a real checksum. Run `abuild checksum` in this
# directory once this package is actually tested with pmbootstrap.
sha512sums="
